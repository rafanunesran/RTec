<?xml version="1.0" encoding="UTF-8"?>
<!--
  App RTec TV para TVs Samsung (Tizen). Abre o site publicado dentro do app, como o app Android.
  Os marcadores entre arrobas (endereco do site, ID e versao) sao trocados por scripts/build-tizen.sh.
  Formato testado numa UN43CU7700 (Tizen 9): com screen-orientation="landscape", tizen:allow-navigation e
  metadados extras o app ficava preso na tela de abertura da Samsung.
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://rtec.app/RTecTV" version="@VERSION@" viewmodes="maximized">
    <access origin="*" subdomains="true"></access>
    <tizen:application id="@PACKAGE_ID@.RTecTV" package="@PACKAGE_ID@" required_version="2.3"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>RTecTV</name>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="auto-rotation" context-menu="enable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
