{
  "name": "rtec-iptv-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test server/app.test.js server/seal.test.js server/games.test.js server/epalerts.test.js",
    "test:firestore": "npx -y firebase-tools@14 emulators:exec --only firestore --project demo-rtec \"node --test server/app.test.js\"",
    "app:android": "bash scripts/build-android.sh",
    "app:tizen": "bash scripts/build-tizen.sh",
    "app:orsay": "bash scripts/build-orsay.sh",
    "app:webos": "bash scripts/build-webos.sh"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/screen-orientation": "^7.0.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.59.0",
    "mpegts.js": "^1.8.2",
    "postcss": "^8.5.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
