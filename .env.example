# Porta do servidor
PORT=3001
# Credenciais do primeiro administrador (criado so se nao existir nenhum)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
# Segredo da sessao (se vazio, e gerado e salvo em data/.jwt-secret)
JWT_SECRET=
# URL publica usada nos links enviados aos clientes (ex: https://iptv.seudominio.com)
PUBLIC_URL=
# Pasta do banco SQLite
DATA_DIR=./data
# Tempo de cache das listas remotas, em segundos
M3U_CACHE_SECONDS=300
