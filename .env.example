# ---------- Firebase (Firestore) ----------
# Cole o JSON da conta de servico (Firebase > Configuracoes do projeto > Contas de servico > Gerar nova chave privada).
# Pode ser o JSON em uma linha ou o JSON em base64.
FIREBASE_SERVICE_ACCOUNT=
# Alternativa ao JSON: as tres variaveis separadas
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Painel ----------
# Credenciais do primeiro administrador (criado so quando nao existe nenhum)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
# Recuperar acesso: defina uma senha nova aqui e faca Redeploy. Ela substitui a senha do ADMIN_USER
# uma unica vez. Depois de entrar, troque a senha no painel e apague esta variavel.
ADMIN_RESET_PASSWORD=
# URL publica usada nos links enviados aos clientes (ex: https://rtec.vercel.app)
PUBLIC_URL=
# Segredo da sessao. Se vazio, e gerado e guardado no Firestore (config/secrets).
JWT_SECRET=

# ---------- Reproducao ----------
# Modo padrao das listas novas: direct (navegador busca na fonte) ou proxy (passa pelo servidor).
# Na Vercel o padrao ja e "direct", para nao gastar a banda do plano gratis.
DEFAULT_PLAYBACK=
# Tempo de cache das listas remotas, em segundos
M3U_CACHE_SECONDS=300

# ---------- Servidor de video separado (opcional, ex: Oracle Cloud) ----------
# Endereco do servidor instalado com public/proxy/install.sh e o segredo compartilhado com ele.
STREAM_PROXY_URL=
PROXY_SECRET=

# ---------- Ficha dos filmes/series (opcional) ----------
# Chave gratuita do TMDB (themoviedb.org > Configuracoes > API). Completa sinopse, elenco, direcao,
# generos, capa e trailer quando o fornecedor nao manda. Sem ela, a sinopse vem da Wikipedia.
TMDB_API_KEY=

# ---------- Tocar em outro aparelho ----------
# Canal de mensagens entre os aparelhos da conta (ntfy). Padrao: https://ntfy.sh (gratis). Pode apontar para um
# ntfy proprio (ex: na Oracle). As mensagens vao cifradas com uma chave da conta.
CAST_RELAY_URL=
